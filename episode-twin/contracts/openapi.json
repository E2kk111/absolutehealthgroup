  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "CreateEpisode": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "patient_ref": {
            "type": "string",
            "pattern": "^patient_synthetic_"
          },
          "pathway_version": {
            "type": "string",
            "minLength": 1
          },
          "simulation_mode": {
            "type": "boolean",
            "enum": [
              true
            ]
          }
        },
        "required": [
          "episode_id",
          "patient_ref",
          "pathway_version",
          "simulation_mode"
        ]
      },
      "StateChange": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "active",
              "closed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "pattern": "^synthetic://"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "type": "string",
            "enum": [
              "discharge",
              "handoff",
              "followup"
            ]
          }
        },
        "required": [
          "evidence_id",
          "source_ref",
          "observed_at",
          "kind"
        ]
      },
      "Task": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "due_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "task_id",
          "title",
          "due_at"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Episode": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "episode_id": {
            "type": "string",
            "minLength": 1
          },
          "tenant_id": {
            "type": "string",
            "minLength": 1
          },
          "patient_ref": {
            "type": "string",
            "minLength": 1
          },
          "pathway_version": {
            "type": "string",
            "minLength": 1
          },
          "simulation_mode": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "review",
              "active",
              "closed"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "authority_state": {
            "type": "string",
            "minLength": 1
          },
          "economic_state": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            }
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "episode_id",
          "tenant_id",
          "patient_ref",
          "pathway_version",
          "simulation_mode",
          "status",
          "version",
          "authority_state",
          "economic_state",
          "evidence",
          "tasks"
        ]
      },
      "Event": {
        "type": "object",
        "required": [
          "sequence",
          "actor_id",
          "operation",
          "snapshot",
          "hash"
        ],
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "actor_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "snapshot": {
            "$ref": "#/components/schemas/Episode"
          },
          "hash": {
            "type": "string",
            "minLength": 1
          },
          "previous_hash": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
