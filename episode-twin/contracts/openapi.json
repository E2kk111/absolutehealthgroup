  "openapi": "3.0.3",
  "info": {
    "title": "GitHealth Episode Twin - draft HTTP adapter contract",
    "version": "0.1.0",
    "description": "Contract only; HTTP adapter not implemented. Synthetic data only. Tenant and actor resolved from validated server-side identity. Body fields cannot supply identity or scopes."
  },
